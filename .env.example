# Скопируйте этот файл в .env (cp .env.example .env) и заполните значения.

# Токен телеграм-бота — выдаёт @BotFather при создании бота
BOT_TOKEN=

# Ключ доступа к QTickets — личный кабинет, раздел «Настройки → Основное», в самом низу
QTICKETS_TOKEN=

# Ваш числовой Телеграм-ID (узнать: напишите боту @userinfobot).
# Можно несколько через запятую — эти люди смогут управлять ботом.
OWNER_IDS=

# Ниже менять обычно не нужно
# QTICKETS_BASE_URL=https://qtickets.ru/api/rest/v1
# DB_PATH=data.db
